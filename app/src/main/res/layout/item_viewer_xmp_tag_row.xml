<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/tiny_margin">

    <ImageView
        android:id="@+id/viewer_xmp_tag_row_icon"
        android:layout_width="@dimen/viewer_xmp_tags_icon_size"
        android:layout_height="@dimen/viewer_xmp_tags_icon_size"
        android:contentDescription="@null"
        tools:src="@drawable/ic_xmp_tags_vector" />

    <TextView
        android:id="@+id/viewer_xmp_tag_row_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:textColor="@android:color/white"
        android:textSize="@dimen/normal_text_size"
        tools:text="vacation" />

</LinearLayout>
