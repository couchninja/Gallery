<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exif_rating_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/circle_black_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/tiny_margin"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/exif_rating_star_1"
        android:layout_width="@dimen/favorite_list_icon_size"
        android:layout_height="@dimen/favorite_list_icon_size"
        android:contentDescription="@null"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_star_outline_vector" />

    <ImageView
        android:id="@+id/exif_rating_star_2"
        android:layout_width="@dimen/favorite_list_icon_size"
        android:layout_height="@dimen/favorite_list_icon_size"
        android:contentDescription="@null"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_star_outline_vector" />

    <ImageView
        android:id="@+id/exif_rating_star_3"
        android:layout_width="@dimen/favorite_list_icon_size"
        android:layout_height="@dimen/favorite_list_icon_size"
        android:contentDescription="@null"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_star_outline_vector" />

    <ImageView
        android:id="@+id/exif_rating_star_4"
        android:layout_width="@dimen/favorite_list_icon_size"
        android:layout_height="@dimen/favorite_list_icon_size"
        android:contentDescription="@null"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_star_outline_vector" />

    <ImageView
        android:id="@+id/exif_rating_star_5"
        android:layout_width="@dimen/favorite_list_icon_size"
        android:layout_height="@dimen/favorite_list_icon_size"
        android:contentDescription="@null"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_star_outline_vector" />

</LinearLayout>
