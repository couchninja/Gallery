<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/manage_thumbnail_grid_view_row_height"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/manage_thumbnail_grid_view_drag_handle_touch_target"
        android:layout_width="@dimen/manage_thumbnail_grid_view_drag_handle_touch_width"
        android:layout_height="@dimen/manage_thumbnail_grid_view_row_height"
        android:contentDescription="@string/reorder_by_dragging">

        <ImageView
            android:id="@+id/manage_thumbnail_grid_view_drag_handle"
            android:layout_width="@dimen/drag_handle_size"
            android:layout_height="@dimen/drag_handle_size"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_manage_view_drag_dots_vector" />
    </FrameLayout>

    <ImageView
        android:id="@+id/manage_thumbnail_grid_view_icon"
        android:layout_width="@dimen/thumbnail_grid_bottom_nav_icon_size"
        android:layout_height="@dimen/thumbnail_grid_bottom_nav_icon_size"
        android:layout_marginStart="@dimen/manage_thumbnail_grid_view_icon_margin_start"
        android:importantForAccessibility="no"
        android:scaleType="centerInside" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/manage_thumbnail_grid_view_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/manage_thumbnail_grid_view_icon_margin_start"
        android:layout_weight="1"
        android:textSize="@dimen/normal_text_size" />

</LinearLayout>
