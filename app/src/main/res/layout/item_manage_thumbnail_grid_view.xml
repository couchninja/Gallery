<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/tiny_margin">

    <ImageView
        android:id="@+id/manage_thumbnail_grid_view_drag_handle"
        android:layout_width="@dimen/drag_handle_size"
        android:layout_height="@dimen/drag_handle_size"
        android:contentDescription="@string/reorder_by_dragging"
        android:scaleType="centerInside"
        android:src="@drawable/ic_manage_view_drag_dots_vector" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/manage_thumbnail_grid_view_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_weight="1"
        android:textSize="@dimen/normal_text_size" />

</LinearLayout>
