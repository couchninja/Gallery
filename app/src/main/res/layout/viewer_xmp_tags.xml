<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewer_xmp_tags_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/viewer_xmp_tags_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/medium_margin"
    android:paddingVertical="@dimen/small_margin"
    android:visibility="invisible"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/viewer_xmp_tags_icon"
        android:layout_width="@dimen/viewer_xmp_tags_icon_size"
        android:layout_height="@dimen/viewer_xmp_tags_icon_size"
        android:contentDescription="@null"
        android:src="@drawable/ic_xmp_tags_vector" />

    <TextView
        android:id="@+id/viewer_xmp_tags_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:textColor="@android:color/white"
        android:textSize="@dimen/normal_text_size"
        tools:text="keep 2 months" />

</LinearLayout>
